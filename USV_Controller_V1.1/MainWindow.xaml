<Window x:Class="USV_Controller_V1._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="USV Controller V1.1"
        Height="665" Width="700"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        Background="{DynamicResource DarkBackgroundGradient}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Glow Effect -->
        <Border Background="Transparent" Padding="0,0,0,15">
            <TextBlock Text="Demolition #1"
                       HorizontalAlignment="Center"
                       Style="{DynamicResource HeaderText}"
                       FontSize="28"/>
        </Border>

        <!-- Main Layout -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- =================== COLUMN 0 - Left Panel =================== -->
            <StackPanel Grid.Column="0" Margin="10,0" VerticalAlignment="Top">

                <!-- Clutch Feedback -->
                <GroupBox Header="Clutch" Style="{DynamicResource MaritimeGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Slider with maritime styling -->
                        <Border Background="{DynamicResource ClutchBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Slider x:Name="ClutchSlider"
                                    Orientation="Vertical"
                                    Minimum="410" Maximum="625"
                                    Value="515"
                                    IsEnabled="False"
                                    Height="180" Width="25"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Style="{DynamicResource MaritimeSlider}"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <TextBlock Text="F" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"
                                       Foreground="{DynamicResource GreenGlowBrush}"/>
                            <TextBlock Text="N" FontSize="14" FontWeight="Bold" Margin="0,45,0,50"
                                       Foreground="{DynamicResource OrangeGlowBrush}"/>
                            <TextBlock Text="R" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource RedGlowBrush}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Contact Switch -->
                <GroupBox Header="Contact Switch" Style="{DynamicResource MaritimeGroupBox}">
                    <StackPanel Margin="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource DarkNavyBrush}" 
                                CornerRadius="15" 
                                Padding="3">
                            <Ellipse x:Name="RelayIndicator"
                                     Width="25" Height="25"
                                     Fill="#FF4444"
                                     Stroke="{DynamicResource PanelBorderBrush}"
                                     StrokeThickness="2"/>
                        </Border>
                        <TextBlock x:Name="RelayText"
                                   Text="OFF"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource LightTextBrush}"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Link Quality -->
                <GroupBox Header="Link Quality" Style="{DynamicResource MaritimeGroupBox}">
                    <StackPanel Margin="0" Orientation="Vertical" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource DarkNavyBrush}" 
                                CornerRadius="15" 
                                Padding="3"
                                HorizontalAlignment="Center">
                            <Ellipse x:Name="LinkIndicator"
                                     Width="25" Height="25"
                                     Fill="#666666"
                                     Stroke="{DynamicResource PanelBorderBrush}"
                                     StrokeThickness="2"/>
                        </Border>
                        <TextBlock x:Name="LinkText"
                                   Text="Disconnected"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DimTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,0"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>

            <!-- =================== COLUMN 1 - Right Panel =================== -->
            <StackPanel Grid.Column="1" Margin="0,0" VerticalAlignment="Top">

                <!-- Speed Feedback - Redesigned Gauges -->
                <GroupBox Header="Speed (RPM)" Style="{DynamicResource MaritimeGroupBox}" Height="270">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left RPM Gauge -->
                        <Grid Grid.Column="0" Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Outer metallic ring -->
                            <Ellipse Width="222" Height="222" 
                                     Stroke="{DynamicResource MetallicRingGradient}" 
                                     StrokeThickness="8"
                                     Fill="Transparent"/>

                            <!-- Dark gauge face -->
                            <Ellipse Width="218" Height="218" 
                                     Fill="{DynamicResource DarkNavyBrush}"
                                     Stroke="{DynamicResource PanelBorderBrush}"
                                     StrokeThickness="1"/>

                            <lvc:PieChart x:Name="RpmPieLeft"
                                          Width="250" Height="250"
                                          IsHitTestVisible="False"
                                          RenderTransformOrigin="0.5,0.5">
                                <lvc:PieChart.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </lvc:PieChart.RenderTransform>
                            </lvc:PieChart>

                            <Canvas IsHitTestVisible="False">
                                <!-- Glowing needle -->
                                <Line x:Name="GaugeNeedleLeft"
                                      X1="125" Y1="125"
                                      X2="125" Y2="35"
                                      Stroke="{DynamicResource CyanAccentBrush}"
                                      StrokeThickness="3"/>
                                <!-- Center hub -->
                                <Ellipse Width="22" Height="22" Canvas.Left="114" Canvas.Top="114"
                                         Fill="{DynamicResource CyanAccentBrush}"/>

                            </Canvas>

                            <!-- Value Display (Refactored) -->
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,45"
                                    Background="{DynamicResource DarkNavyBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="4,2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="SpeedValueTextLeft"
                                               Text="0 %"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource CyanTextBrush}"/>
                                    <TextBlock Text=" Refrence Speed"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource LightTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>



                        <!-- Right RPM Gauge -->
                        <Grid Grid.Column="1" Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Outer metallic ring -->
                            <Ellipse Width="222" Height="222" 
                                     Stroke="{DynamicResource MetallicRingGradient}" 
                                     StrokeThickness="8"
                                     Fill="Transparent"/>

                            <!-- Dark gauge face -->
                            <Ellipse Width="218" Height="218" 
                                     Fill="{DynamicResource DarkNavyBrush}"
                                     Stroke="{DynamicResource PanelBorderBrush}"
                                     StrokeThickness="1"/>

                            <lvc:PieChart x:Name="RpmPieRight"
                                          Width="250" Height="250"
                                          IsHitTestVisible="False"
                                          RenderTransformOrigin="0.5,0.5">
                                <lvc:PieChart.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </lvc:PieChart.RenderTransform>
                            </lvc:PieChart>

                            <Canvas IsHitTestVisible="False">
                                <!-- Glowing needle -->
                                <Line x:Name="GaugeNeedleRight"
                                      X1="125" Y1="125"
                                      X2="125" Y2="35"
                                      Stroke="{DynamicResource CyanAccentBrush}"
                                      StrokeThickness="3"/>
                                <!-- Center hub -->
                                <Ellipse Width="22" Height="22" Canvas.Left="114" Canvas.Top="114"
                                         Fill="{DynamicResource CyanAccentBrush}"/>

                            </Canvas>

                            <!-- Value Display (Refactored) -->
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,45"
                                    Background="{DynamicResource DarkNavyBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="4,2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="SpeedValueTextRight"
                                               Text="0 %"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource CyanTextBrush}"/>
                                    <TextBlock Text=" Actual Speed"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource LightTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>


                    </Grid>
                </GroupBox>

                <!-- Rudder Feedback - Maritime Redesign -->
                <GroupBox Header="Rudder" Style="{DynamicResource MaritimeGroupBox}">
                    <Grid>
                        <Canvas x:Name="RudderCanvas"
                                Height="100"
                                Width="400"
                                Background="{DynamicResource DarkNavyBrush}"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <!-- Port (Left) zone - Red tint -->
                            <Rectangle Width="180" Height="10" Canvas.Left="20" Canvas.Top="45"
                                       Fill="#44FF4444"/>

                            <!-- Starboard (Right) zone - Green tint -->
                            <Rectangle Width="180" Height="10" Canvas.Left="200" Canvas.Top="45"
                                       Fill="#4400FF88"/>

                            <!-- Main scale line -->
                            <Line X1="20" Y1="50" X2="380" Y2="50" 
                                  Stroke="{DynamicResource CyanAccentBrush}" 
                                  StrokeThickness="2"/>

                            <!-- Tick marks -->
                            <Line X1="20"  Y1="40" X2="20"  Y2="60" Stroke="{DynamicResource CyanAccentBrush}" StrokeThickness="1"/>
                            <Line X1="80"  Y1="40" X2="80"  Y2="60" Stroke="{DynamicResource CyanAccentBrush}" StrokeThickness="1"/>
                            <Line X1="140" Y1="40" X2="140" Y2="60" Stroke="{DynamicResource CyanAccentBrush}" StrokeThickness="1"/>
                            <Line X1="200" Y1="40" X2="200" Y2="60" Stroke="{DynamicResource CyanAccentBrush}" StrokeThickness="2"/>
                            <Line X1="260" Y1="40" X2="260" Y2="60" Stroke="{DynamicResource CyanAccentBrush}" StrokeThickness="1"/>
                            <Line X1="320" Y1="40" X2="320" Y2="60" Stroke="{DynamicResource CyanAccentBrush}" StrokeThickness="1"/>
                            <Line X1="380" Y1="40" X2="380" Y2="60" Stroke="{DynamicResource CyanAccentBrush}" StrokeThickness="1"/>

                            <!-- Degree labels -->
                            <TextBlock Text="-30" Canvas.Left="10"  Canvas.Top="65" FontWeight="Bold" Foreground="{DynamicResource RedGlowBrush}" FontSize="10"/>
                            <TextBlock Text="-20" Canvas.Left="70"  Canvas.Top="65" FontWeight="Bold" Foreground="{DynamicResource LightTextBrush}" FontSize="10"/>
                            <TextBlock Text="-10" Canvas.Left="130" Canvas.Top="65" FontWeight="Bold" Foreground="{DynamicResource LightTextBrush}" FontSize="10"/>
                            <TextBlock Text="0"   Canvas.Left="197" Canvas.Top="65" FontWeight="Bold" Foreground="{DynamicResource CyanTextBrush}" FontSize="10"/>
                            <TextBlock Text="+10" Canvas.Left="250" Canvas.Top="65" FontWeight="Bold" Foreground="{DynamicResource LightTextBrush}" FontSize="10"/>
                            <TextBlock Text="+20" Canvas.Left="310" Canvas.Top="65" FontWeight="Bold" Foreground="{DynamicResource LightTextBrush}" FontSize="10"/>
                            <TextBlock Text="+30" Canvas.Left="367" Canvas.Top="65" FontWeight="Bold" Foreground="{DynamicResource GreenGlowBrush}" FontSize="10"/>

                            <!-- Glowing position indicator -->
                            <Rectangle x:Name="RudderIndicator"
                                       Width="12" Height="30"
                                       Canvas.Top="35"
                                       Canvas.Left="194"
                                       RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource CyanAccentBrush}"/>
                        </Canvas>

                        <TextBlock x:Name="SteeringValueText"
                                   Text="0"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource CyanTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,1"/>
                    </Grid>
                </GroupBox>

            </StackPanel>

        </Grid>

        <!-- =================== ESP Explosive Circuit Status Panel =================== -->
        <GroupBox Grid.Row="2" Header="Explosive Circuit Status" Style="{DynamicResource MaritimeGroupBox}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Relay 1: Door/Gate -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource DarkNavyBrush}" 
                            CornerRadius="15" 
                            Padding="3"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,5">
                        <Ellipse x:Name="EspRelay1Led"
                                 Width="25" Height="25"
                                 Fill="#666666"
                                 Stroke="{DynamicResource PanelBorderBrush}"
                                 StrokeThickness="2"/>
                    </Border>
                    <TextBlock Text="USV Authentication"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LightTextBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Relay 2: Position -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource DarkNavyBrush}" 
            CornerRadius="15" 
            Padding="3"
            HorizontalAlignment="Center"
            Margin="0,0,0,5">
                        <Ellipse x:Name="EspRelay2Led"
                 Width="25" Height="25"
                 Fill="#666666"
                 Stroke="{DynamicResource PanelBorderBrush}"
                 StrokeThickness="2"/>
                    </Border>
                    <TextBlock x:Name="GpsDistanceText"
               Text="Position"
               FontSize="11"
               FontWeight="SemiBold"
               Foreground="{DynamicResource LightTextBrush}"
               HorizontalAlignment="Center"
               TextWrapping="Wrap"
               TextAlignment="Center"/>
                </StackPanel>

                <!-- Relay 3: Speed -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource DarkNavyBrush}" 
                            CornerRadius="15" 
                            Padding="3"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,5">
                        <Ellipse x:Name="EspRelay3Led"
                                 Width="25" Height="25"
                                 Fill="#666666"
                                 Stroke="{DynamicResource PanelBorderBrush}"
                                 StrokeThickness="2"/>
                    </Border>
                    <TextBlock Text="Speed"
                               Name="SpeedText"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LightTextBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Relay 4: Fire -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource DarkNavyBrush}" 
                            CornerRadius="15" 
                            Padding="3"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,5">
                        <Ellipse x:Name="EspRelay4Led"
                                 Width="25" Height="25"
                                 Fill="#666666"
                                 Stroke="{DynamicResource PanelBorderBrush}"
                                 StrokeThickness="2"/>
                    </Border>
                    <TextBlock Text="Fire"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LightTextBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Groundstation Door -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource DarkNavyBrush}" 
                            CornerRadius="15" 
                            Padding="3"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,5">
                        <Ellipse x:Name="GroundStationDoorLed"
                                 Width="25" Height="25"
                                 Fill="Gray"
                                 Stroke="{DynamicResource PanelBorderBrush}"
                                 StrokeThickness="2"/>
                    </Border>
                    <TextBlock Text="GS Authentication"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LightTextBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        
    </Grid>
</Window>