<Window x:Class="USV_Controller_V1._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="USV Controller V1.1"
        Height="680" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="USV Controller"
                   HorizontalAlignment="Center"
                   FontSize="26" FontWeight="Bold"
                   Foreground="#333"
                   Margin="10"/>

        <!-- Main Layout -->
        <Grid Grid.Row="1" Margin="0,20,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- =================== COLUMN 0 (unchanged) =================== -->
            <StackPanel Grid.Column="0" Margin="10,0" VerticalAlignment="Top">

                <!-- Clutch Feedback -->
                <GroupBox Header="Clutch" FontWeight="Bold" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Slider x:Name="ClutchSlider"
                                Orientation="Vertical"
                                Minimum="410" Maximum="625"
                                Value="515"
                                IsEnabled="False"
                                Height="180" Width="25"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Foreground="#2196F3"
                                Background="White"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <TextBlock Text="F" FontSize="14" FontWeight="Bold" Foreground="Green" Margin="0,0,0,10"/>
                            <TextBlock Text="N" FontSize="14" FontWeight="Bold" Foreground="Orange" Margin="0,50,0,50"/>
                            <TextBlock Text="R" FontSize="14" FontWeight="Bold" Foreground="Red"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Contact Switch -->
                <GroupBox Header="Contact Switch" FontWeight="Bold" Margin="0,0,0,10">
                    <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="RelayIndicator"
                                 Width="25" Height="25"
                                 Fill="Red"
                                 Stroke="#333"
                                 StrokeThickness="1"/>
                        <TextBlock x:Name="RelayText"
                                   Text="OFF"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Link Quality -->
                <GroupBox Header="Link Quality" FontWeight="Bold" Margin="0,0,0,10">
                    <StackPanel Margin="10" Orientation="Vertical" HorizontalAlignment="Center">
                        <Ellipse x:Name="LinkIndicator"
                                 Width="25" Height="25"
                                 Fill="Gray"
                                 Stroke="#333"
                                 StrokeThickness="1"/>
                        <TextBlock x:Name="LinkText"
                                   Text="Disconnected"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- UDP Connection -->
                <GroupBox Header="Connection" FontWeight="Bold" Margin="0,0,0,10">
                    <StackPanel Orientation="Vertical" Margin="10">
                        <Button x:Name="ConnectButton" Content="Connect" Width="60" Click="ConnectButton_Click"/>
                        <Button x:Name="DisconnectButton" Content="Disconnect" Width="70" Margin="0,10,0,0" Click="DisconnectButton_Click"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>

            <!-- =================== COLUMN 1 (unchanged) =================== -->
            <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Top">

                <!-- Speed Feedback -->
                <GroupBox Header="Speed (RPM)" FontWeight="Bold" Margin="0,10,0,0" Height="256">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left RPM -->
                        <Grid Grid.Column="0" Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <lvc:PieChart x:Name="RpmPieLeft"
                                          Width="250" Height="250"
                                          IsHitTestVisible="False"
                                          RenderTransformOrigin="0.5,0.5">
                                <lvc:PieChart.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </lvc:PieChart.RenderTransform>
                            </lvc:PieChart>

                            <Canvas IsHitTestVisible="False">
                                <Line x:Name="GaugeNeedleLeft"
                                      X1="125" Y1="125"
                                      X2="125" Y2="35"
                                      Stroke="Black"
                                      StrokeThickness="3"/>
                                <Ellipse Width="18" Height="18" Fill="Black" Canvas.Left="116" Canvas.Top="116"/>
                                <TextBlock x:Name="SpeedValueTextLeft"
                                           Text="0 RPM"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Canvas.Left="85"
                                           Canvas.Top="140"/>
                            </Canvas>
                        </Grid>

                        <TextBlock Text="Ordered Speed"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,8,0,0"/>

                        <!-- Right RPM -->
                        <Grid Grid.Column="1" Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <lvc:PieChart x:Name="RpmPieRight"
                                          Width="250" Height="250"
                                          IsHitTestVisible="False"
                                          RenderTransformOrigin="0.5,0.5">
                                <lvc:PieChart.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </lvc:PieChart.RenderTransform>
                            </lvc:PieChart>

                            <Canvas IsHitTestVisible="False">
                                <Line x:Name="GaugeNeedleRight"
                                      X1="125" Y1="125"
                                      X2="125" Y2="35"
                                      Stroke="Black"
                                      StrokeThickness="3"/>
                                <Ellipse Width="18" Height="18" Fill="Black" Canvas.Left="116" Canvas.Top="116"/>
                                <TextBlock x:Name="SpeedValueTextRight"
                                           Text="0 RPM"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Canvas.Left="85"
                                           Canvas.Top="140"/>
                            </Canvas>
                        </Grid>

                        <TextBlock Text="Actual Speed"
                                   Grid.Column="1"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,8,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- Rudder Feedback -->
                <GroupBox Header="Rudder (°)" FontWeight="Bold" Margin="0,10,0,0">
                    <Grid>
                        <Canvas x:Name="RudderCanvas"
                                Height="100"
                                Width="400"
                                Background="#F5F5F5"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Rectangle Width="180" Height="10" Fill="#FFB3B3" Canvas.Left="20" Canvas.Top="45"/>
                            <Rectangle Width="180" Height="10" Fill="#B3FFB3" Canvas.Left="200" Canvas.Top="45"/>

                            <Line X1="20" Y1="50" X2="380" Y2="50" Stroke="Black" StrokeThickness="2"/>
                            <Line X1="20"  Y1="40" X2="20"  Y2="60" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="80"  Y1="40" X2="80"  Y2="60" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="140" Y1="40" X2="140" Y2="60" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="200" Y1="40" X2="200" Y2="60" Stroke="Black" StrokeThickness="2"/>
                            <Line X1="260" Y1="40" X2="260" Y2="60" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="320" Y1="40" X2="320" Y2="60" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="380" Y1="40" X2="380" Y2="60" Stroke="Black" StrokeThickness="1"/>

                            <TextBlock Text="-30°" Canvas.Left="10"  Canvas.Top="65" FontWeight="Bold"/>
                            <TextBlock Text="-20°" Canvas.Left="70"  Canvas.Top="65" FontWeight="Bold"/>
                            <TextBlock Text="-10°" Canvas.Left="130" Canvas.Top="65" FontWeight="Bold"/>
                            <TextBlock Text="0°"   Canvas.Left="195" Canvas.Top="65" FontWeight="Bold"/>
                            <TextBlock Text="+10°" Canvas.Left="250" Canvas.Top="65" FontWeight="Bold"/>
                            <TextBlock Text="+20°" Canvas.Left="310" Canvas.Top="65" FontWeight="Bold"/>
                            <TextBlock Text="+30°" Canvas.Left="370" Canvas.Top="65" FontWeight="Bold"/>

                            <Rectangle x:Name="RudderIndicator"
                                       Width="12" Height="25"
                                       Fill="#4CAF50"
                                       Stroke="Black"
                                       RadiusX="2" RadiusY="2"
                                       Canvas.Top="38"
                                       Canvas.Left="194"/>
                        </Canvas>

                        <TextBlock x:Name="SteeringValueText"
                                   Text="0°"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,1"/>
                    </Grid>
                </GroupBox>

            </StackPanel>

        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2"
                   Text="© 2025 مركز البحوث الفنية و المعايرة القوات البحرية"
                   HorizontalAlignment="Center"
                   Foreground="#666"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>
