<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- =================== LIGHT MARITIME COLOR PALETTE (DAY MODE) =================== -->
    
    <!-- Background Colors (Grayscale for "Little Gray" Day Mode) -->
    <Color x:Key="DarkNavy">#F0F0F0</Color>
    <Color x:Key="MidNavy">#E0E0E0</Color>
    <Color x:Key="LightNavy">#D0D0D0</Color>
    <Color x:Key="PanelBorder">#A0A0A0</Color>
    
    <!-- Accent Colors (Black for maximum contrast) -->
    <Color x:Key="CyanAccent">#000000</Color>
    <Color x:Key="TealAccent">#000000</Color>
    <Color x:Key="GreenGlow">#00AA55</Color> <!-- Restored to Green for 'F' Label -->
    <Color x:Key="RedGlow">#CC2222</Color>
    <Color x:Key="OrangeGlow">#DD8800</Color>
    <Color x:Key="YellowGlow">#CCAA00</Color>
    
    <!-- Special Day Mode Colors -->
    <Color x:Key="SliderGlowColor">#111111</Color>
    
    <!-- Text Colors (Black for maximum contrast) -->
    <Color x:Key="LightText">#000000</Color>
    <Color x:Key="DimText">#000000</Color>
    <Color x:Key="CyanText">#000000</Color>
    
    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="DarkNavyBrush" Color="{StaticResource DarkNavy}"/>
    <SolidColorBrush x:Key="MidNavyBrush" Color="{StaticResource MidNavy}"/>
    <SolidColorBrush x:Key="LightNavyBrush" Color="{StaticResource LightNavy}"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorder}"/>
    <SolidColorBrush x:Key="CyanAccentBrush" Color="{StaticResource CyanAccent}"/>
    <SolidColorBrush x:Key="TealAccentBrush" Color="{StaticResource TealAccent}"/>
    <SolidColorBrush x:Key="GreenGlowBrush" Color="{StaticResource GreenGlow}"/>
    <SolidColorBrush x:Key="RedGlowBrush" Color="{StaticResource RedGlow}"/>
    <SolidColorBrush x:Key="OrangeGlowBrush" Color="{StaticResource OrangeGlow}"/>
    <SolidColorBrush x:Key="LightTextBrush" Color="{StaticResource LightText}"/>
    <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimText}"/>
    <SolidColorBrush x:Key="CyanTextBrush" Color="{StaticResource CyanText}"/>
    
    <!-- Decoupled Brushes -->
    <SolidColorBrush x:Key="LogTextBrush" Color="Black"/>
    <SolidColorBrush x:Key="ClutchBackgroundBrush" Color="{StaticResource DarkNavy}"/>
    
    <!-- Gradient Brushes (Light versions) -->
    <LinearGradientBrush x:Key="DarkBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F8F8F8" Offset="0"/>
        <GradientStop Color="#EEEEEE" Offset="0.3"/>
        <GradientStop Color="#DDDDDD" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0F0F0" Offset="0"/>
        <GradientStop Color="#E0E0E0" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="MetallicRingGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#606060" Offset="0"/>
        <GradientStop Color="#404040" Offset="0.5"/>
        <GradientStop Color="#606060" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- =================== GLOW EFFECTS (Subtle for day mode) =================== -->
    
    <DropShadowEffect x:Key="CyanGlow" Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
    <DropShadowEffect x:Key="GreenGlowEffect" Color="#00AA55" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
    <DropShadowEffect x:Key="RedGlowEffect" Color="#CC2222" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
    <DropShadowEffect x:Key="OrangeGlowEffect" Color="#DD8800" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
    <DropShadowEffect x:Key="SubtleGlow" Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
    
</ResourceDictionary>
