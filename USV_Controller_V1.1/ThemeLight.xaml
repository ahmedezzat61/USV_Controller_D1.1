<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- =================== LIGHT MARITIME COLOR PALETTE (DAY MODE) =================== -->
    
    <!-- Background Colors (Grayscale for "Little Gray" Day Mode) -->
    <Color x:Key="DarkNavy">#F8FAFC</Color>
    <Color x:Key="MidNavy">#FFFFFF</Color>
    <Color x:Key="LightNavy">#E2E8F0</Color>
    <Color x:Key="PanelBorder">#CBD5E1</Color>
    
    <!-- Accent Colors (Black for maximum contrast) -->
    <Color x:Key="CyanAccent">#0369A1</Color>
    <Color x:Key="TealAccent">#0284C7</Color>
    <Color x:Key="GreenGlow">#047857</Color>
    <Color x:Key="RedGlow">#B91C1C</Color>
    <Color x:Key="OrangeGlow">#B45309</Color>
    <Color x:Key="YellowGlow">#A16207</Color>
    
    <!-- Special Day Mode Colors -->
    <Color x:Key="SliderGlowColor">#0369A1</Color>
    
    <!-- Text Colors (Black for maximum contrast) -->
    <Color x:Key="LightText">#0F172A</Color>
    <Color x:Key="DimText">#475569</Color>
    <Color x:Key="CyanText">#075985</Color>
    
    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="DarkNavyBrush" Color="{StaticResource DarkNavy}"/>
    <SolidColorBrush x:Key="MidNavyBrush" Color="{StaticResource MidNavy}"/>
    <SolidColorBrush x:Key="LightNavyBrush" Color="{StaticResource LightNavy}"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorder}"/>
    <SolidColorBrush x:Key="CyanAccentBrush" Color="{StaticResource CyanAccent}"/>
    <SolidColorBrush x:Key="TealAccentBrush" Color="{StaticResource TealAccent}"/>
    <SolidColorBrush x:Key="GreenGlowBrush" Color="{StaticResource GreenGlow}"/>
    <SolidColorBrush x:Key="RedGlowBrush" Color="{StaticResource RedGlow}"/>
    <SolidColorBrush x:Key="OrangeGlowBrush" Color="{StaticResource OrangeGlow}"/>
    <SolidColorBrush x:Key="LightTextBrush" Color="{StaticResource LightText}"/>
    <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimText}"/>
    <SolidColorBrush x:Key="CyanTextBrush" Color="{StaticResource CyanText}"/>
    
    <!-- Decoupled Brushes -->
    <SolidColorBrush x:Key="LogTextBrush" Color="Black"/>
    <SolidColorBrush x:Key="ClutchBackgroundBrush" Color="{StaticResource DarkNavy}"/>
    
    <!-- Gradient Brushes (Light versions) -->
    <LinearGradientBrush x:Key="DarkBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F8FAFC" Offset="0"/>
        <GradientStop Color="#F1F5F9" Offset="0.3"/>
        <GradientStop Color="#E2E8F0" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F8FAFC" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="MetallicRingGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#94A3B8" Offset="0"/>
        <GradientStop Color="#64748B" Offset="0.5"/>
        <GradientStop Color="#94A3B8" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- =================== GLOW EFFECTS (Subtle for day mode) =================== -->
    
    <DropShadowEffect x:Key="CyanGlow" Color="#0369A1" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
    <DropShadowEffect x:Key="GreenGlowEffect" Color="#047857" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
    <DropShadowEffect x:Key="RedGlowEffect" Color="#B91C1C" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
    <DropShadowEffect x:Key="OrangeGlowEffect" Color="#B45309" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
    <DropShadowEffect x:Key="SubtleGlow" Color="#0369A1" BlurRadius="6" ShadowDepth="0" Opacity="0.2"/>
    
</ResourceDictionary>
