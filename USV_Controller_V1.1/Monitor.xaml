<Window x:Class="USV_Controller_V1._1.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        Height="450"
        Width="380"
        Background="{DynamicResource DarkBackgroundGradient}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
             <RowDefinition Height="*"/>
             <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

         <!--Packet Preview--> 
        <!--<GroupBox Grid.Row="1"
                  Header="Packet Preview"
                  Style="{DynamicResource MaritimeGroupBox}">
            <Border Background="{DynamicResource DarkNavyBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10">
                <TextBlock x:Name="PacketPreview"
                           Text="[00 00 00 ...]"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource CyanTextBrush}"/>
            </Border>
        </GroupBox>-->

        <!-- Log -->
        <GroupBox Grid.Row="2"
                  Header="Raw Log"
                  Style="{DynamicResource MaritimeGroupBox}" Margin="0,0,0,10">
            <Border Background="{DynamicResource DarkNavyBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <TextBox x:Name="RawLog"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Padding="10"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="Transparent"
                         Foreground="{DynamicResource LogTextBrush}"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource CyanAccentBrush}"/>
            </Border>
        </GroupBox>
        <!-- Footer -->
        <Border Grid.Row="3" 
        Background="{DynamicResource MidNavyBrush}"
        CornerRadius="4"
        Padding="10,1"
        Margin="0,0,0,0">
            <TextBlock Text="© 2025 مركز البحوث الفنية و المعايرة القوات البحرية"
               HorizontalAlignment="Center"
               Foreground="{DynamicResource DimTextBrush}"
               FontSize="12"/>
        </Border>
    </Grid>
</Window>
