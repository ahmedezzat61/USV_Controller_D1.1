<Window x:Class="USV_Controller_V1._1.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D-Class | System Log"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        Height="450"
        Width="380"
        Background="{DynamicResource DarkBackgroundGradient}"
        WindowStartupLocation="Manual">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource MidNavyBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋"
                               FontSize="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="SYSTEM LOG"
                                   Foreground="{DynamicResource LightTextBrush}"
                                   FontWeight="Bold"
                                   FontSize="13"/>
                        <TextBlock Text="Live station events"
                                   Foreground="{DynamicResource DimTextBrush}"
                                   FontSize="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <GroupBox Grid.Row="1"
                      Header="Raw Log"
                      Style="{DynamicResource MaritimeGroupBox}"
                      Margin="0,0,0,10">
                <Border Background="{DynamicResource DarkNavyBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBox x:Name="RawLog"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             Padding="12"
                             FontFamily="Consolas"
                             FontSize="11"
                             Background="Transparent"
                             Foreground="{DynamicResource LogTextBrush}"
                             BorderThickness="0"
                             CaretBrush="{DynamicResource CyanAccentBrush}"
                             SelectionBrush="{DynamicResource CyanAccentBrush}"/>
                </Border>
            </GroupBox>

            <Border Grid.Row="2"
                    Background="{DynamicResource MidNavyBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,5">
                <TextBlock Text="© 2025 مركز البحوث الفنية و المعايرة القوات البحرية"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource DimTextBrush}"
                           FontSize="11"/>
            </Border>
    </Grid>
</Window>
