<Window x:Class="USV_Controller_V1._1.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor"
        Height="450"
        Width="380"
        Background="{DynamicResource DarkBackgroundGradient}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Packet Preview -->
        <GroupBox Grid.Row="0"
                  Header="Packet Preview"
                  Style="{DynamicResource MaritimeGroupBox}">
            <Border Background="{DynamicResource DarkNavyBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10">
                <TextBlock x:Name="PacketPreview"
                           Text="[00 00 00 ...]"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource CyanTextBrush}"/>
            </Border>
        </GroupBox>

        <!-- Log -->
        <GroupBox Grid.Row="2"
                  Header="Raw Log"
                  Style="{DynamicResource MaritimeGroupBox}">
            <Border Background="{DynamicResource DarkNavyBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <TextBox x:Name="RawLog"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Padding="10"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="Transparent"
                         Foreground="{DynamicResource LogTextBrush}"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource CyanAccentBrush}"/>
            </Border>
        </GroupBox>
    </Grid>
</Window>
