<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- =================== DARK MARITIME COLOR PALETTE (NIGHT MODE) =================== -->
    
    <!-- Background Colors -->
    <Color x:Key="DarkNavy">#0D1B2A</Color>
    <Color x:Key="MidNavy">#1B3A4B</Color>
    <Color x:Key="LightNavy">#2B4A5B</Color>
    <Color x:Key="PanelBorder">#3A5A6B</Color>
    
    <!-- Accent Colors -->
    <Color x:Key="CyanAccent">#00D4FF</Color>
    <Color x:Key="TealAccent">#00B4CC</Color>
    <Color x:Key="GreenGlow">#00FF88</Color>
    <Color x:Key="RedGlow">#FF4444</Color>
    <Color x:Key="OrangeGlow">#FFA500</Color>
    <Color x:Key="YellowGlow">#FFDD00</Color>
    
    <!-- Text Colors -->
    <Color x:Key="LightText">#E8F4F8</Color>
    <Color x:Key="DimText">#8899AA</Color>
    <Color x:Key="CyanText">#00D4FF</Color>
    
    <!-- Special Day Mode Colors (Mapped to standard colors in Dark Mode) -->
    <Color x:Key="SliderGlowColor">#00D4FF</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="DarkNavyBrush" Color="{StaticResource DarkNavy}"/>
    <SolidColorBrush x:Key="MidNavyBrush" Color="{StaticResource MidNavy}"/>
    <SolidColorBrush x:Key="LightNavyBrush" Color="{StaticResource LightNavy}"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorder}"/>
    <SolidColorBrush x:Key="CyanAccentBrush" Color="{StaticResource CyanAccent}"/>
    <SolidColorBrush x:Key="TealAccentBrush" Color="{StaticResource TealAccent}"/>
    <SolidColorBrush x:Key="GreenGlowBrush" Color="{StaticResource GreenGlow}"/>
    <SolidColorBrush x:Key="RedGlowBrush" Color="{StaticResource RedGlow}"/>
    <SolidColorBrush x:Key="OrangeGlowBrush" Color="{StaticResource OrangeGlow}"/>
    <SolidColorBrush x:Key="LightTextBrush" Color="{StaticResource LightText}"/>
    <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimText}"/>
    <SolidColorBrush x:Key="CyanTextBrush" Color="{StaticResource CyanText}"/>
    
    <!-- Decoupled Brushes -->
    <SolidColorBrush x:Key="LogTextBrush" Color="{StaticResource GreenGlow}"/>
    <SolidColorBrush x:Key="ClutchBackgroundBrush" Color="{StaticResource DarkNavy}"/>
    
    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="DarkBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A1520" Offset="0"/>
        <GradientStop Color="#0D1B2A" Offset="0.3"/>
        <GradientStop Color="#1B3A4B" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B3A4B" Offset="0"/>
        <GradientStop Color="#152535" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="MetallicRingGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4A6A7B" Offset="0"/>
        <GradientStop Color="#2A4A5B" Offset="0.5"/>
        <GradientStop Color="#4A6A7B" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- =================== GLOW EFFECTS =================== -->
    
    <DropShadowEffect x:Key="CyanGlow" Color="#00D4FF" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
    <DropShadowEffect x:Key="GreenGlowEffect" Color="#00FF88" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
    <DropShadowEffect x:Key="RedGlowEffect" Color="#FF4444" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
    <DropShadowEffect x:Key="OrangeGlowEffect" Color="#FFA500" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
    <DropShadowEffect x:Key="SubtleGlow" Color="#00D4FF" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
    
</ResourceDictionary>
