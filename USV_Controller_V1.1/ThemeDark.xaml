<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- =================== DARK MARITIME COLOR PALETTE (NIGHT MODE) =================== -->
    
    <!-- Background Colors -->
    <Color x:Key="DarkNavy">#080D1A</Color>
    <Color x:Key="MidNavy">#111827</Color>
    <Color x:Key="LightNavy">#1F2937</Color>
    <Color x:Key="PanelBorder">#334155</Color>
    
    <!-- Accent Colors -->
    <Color x:Key="CyanAccent">#0284C7</Color>
    <Color x:Key="TealAccent">#38BDF8</Color>
    <Color x:Key="GreenGlow">#34D399</Color>
    <Color x:Key="RedGlow">#F87171</Color>
    <Color x:Key="OrangeGlow">#FBBF24</Color>
    <Color x:Key="YellowGlow">#FDE047</Color>
    
    <!-- Text Colors -->
    <Color x:Key="LightText">#F8FAFC</Color>
    <Color x:Key="DimText">#94A3B8</Color>
    <Color x:Key="CyanText">#38BDF8</Color>
    
    <!-- Special Day Mode Colors (Mapped to standard colors in Dark Mode) -->
    <Color x:Key="SliderGlowColor">#0284C7</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="DarkNavyBrush" Color="{StaticResource DarkNavy}"/>
    <SolidColorBrush x:Key="MidNavyBrush" Color="{StaticResource MidNavy}"/>
    <SolidColorBrush x:Key="LightNavyBrush" Color="{StaticResource LightNavy}"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorder}"/>
    <SolidColorBrush x:Key="CyanAccentBrush" Color="{StaticResource CyanAccent}"/>
    <SolidColorBrush x:Key="TealAccentBrush" Color="{StaticResource TealAccent}"/>
    <SolidColorBrush x:Key="GreenGlowBrush" Color="{StaticResource GreenGlow}"/>
    <SolidColorBrush x:Key="RedGlowBrush" Color="{StaticResource RedGlow}"/>
    <SolidColorBrush x:Key="OrangeGlowBrush" Color="{StaticResource OrangeGlow}"/>
    <SolidColorBrush x:Key="LightTextBrush" Color="{StaticResource LightText}"/>
    <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimText}"/>
    <SolidColorBrush x:Key="CyanTextBrush" Color="{StaticResource CyanText}"/>
    
    <!-- Decoupled Brushes -->
    <SolidColorBrush x:Key="LogTextBrush" Color="{StaticResource GreenGlow}"/>
    <SolidColorBrush x:Key="ClutchBackgroundBrush" Color="{StaticResource DarkNavy}"/>
    
    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="DarkBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#080D1A" Offset="0"/>
        <GradientStop Color="#0B111E" Offset="0.3"/>
        <GradientStop Color="#111827" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#111827" Offset="0"/>
        <GradientStop Color="#0F172A" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="MetallicRingGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#475569" Offset="0"/>
        <GradientStop Color="#1E293B" Offset="0.5"/>
        <GradientStop Color="#475569" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- =================== GLOW EFFECTS =================== -->
    
    <DropShadowEffect x:Key="CyanGlow" Color="#0284C7" BlurRadius="15" ShadowDepth="0" Opacity="0.55"/>
    <DropShadowEffect x:Key="GreenGlowEffect" Color="#34D399" BlurRadius="20" ShadowDepth="0" Opacity="0.65"/>
    <DropShadowEffect x:Key="RedGlowEffect" Color="#F87171" BlurRadius="20" ShadowDepth="0" Opacity="0.65"/>
    <DropShadowEffect x:Key="OrangeGlowEffect" Color="#FBBF24" BlurRadius="15" ShadowDepth="0" Opacity="0.55"/>
    <DropShadowEffect x:Key="SubtleGlow" Color="#0284C7" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
    
</ResourceDictionary>
